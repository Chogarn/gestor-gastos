POSTGRES_USER=gastos
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=gastos

# Firma las cookies de sesión. Debe ser larga, aleatoria y secreta; si la cambias,
# se cierran las sesiones abiertas. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio

# true cuando la app se sirva por HTTPS
SESSION_COOKIE_SECURE=false
