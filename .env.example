POSTGRES_USER=gastos
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=gastos

# Firma las cookies de sesión. Debe ser larga, aleatoria y secreta; si la cambias,
# se cierran las sesiones abiertas. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio

# true cuando la app se sirva por HTTPS. En producción (docker-compose.prod.yml) se fuerza
# a true, así que aquí solo importa si publicas la app por otra vía.
SESSION_COOKIE_SECURE=false

# Solo para producción (docker-compose.prod.yml): dominio público, con su registro DNS A
# apuntando a este servidor. Caddy pide el certificado HTTPS para él. Ejemplo: gastos.midominio.com
# DOMAIN=
